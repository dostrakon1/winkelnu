# Public application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Catalog persistence: memory | curated | supabase
# - memory: synthetic development/test data; never public.
# - curated: safe product-only pre-affiliate catalog; no merchants, prices or outbound offers.
# - supabase: persistent catalog. Until real commerce is explicitly released, the public
#   storefront safely falls back to the curated catalog.
CATALOG_PERSISTENCE=curated

# Explicit release gate for real persistent merchant/affiliate data.
# Only `true` together with CATALOG_PERSISTENCE=supabase exposes the Supabase catalog publicly.
WINKELNU_PUBLIC_CATALOG_ENABLED=false
# Emergency kill switch for the curated fallback. Leave unset/true for the pre-affiliate catalog.
WINKELNU_CURATED_CATALOG_ENABLED=true

# Supabase privileged server configuration.
# These values are server-only. NEVER expose SUPABASE_SERVICE_ROLE_KEY with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Supabase Auth session boundary.
# URL + publishable key may be used by the browser/auth session layer.
# Do not put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Lootje & Lijstje release gate.
# Production is fail-closed: both `true` and a valid 32+ byte session secret are required.
# Automatic gift-data cleanup runs database-local through pg_cron; no Vercel Cron is needed for it.
WINKELNU_GIFTING_ENABLED=false
# No-login capability session signing and keyed abuse-limit buckets.
# Use a dedicated high-entropy server-only value (32+ random bytes).
# Do not reuse the Supabase service-role key or any other application secret.
WINKELNU_GIFT_SESSION_SECRET=

# Human operator access policy. Server-side policy even though the authenticated
# session itself uses the publishable key.
WINKELNU_OPERATOR_EMAILS=
WINKELNU_OPERATOR_ROLES=

# Server-only operations trigger used by the catalog import scheduler/worker.
# This is unrelated to Lootje & Lijstje retention cleanup.
# For Vercel Cron, prefer CRON_SECRET because Vercel can attach it as a Bearer token.
# WINKELNU_IMPORT_TRIGGER_SECRET remains the generic fallback for external/manual schedulers.
CRON_SECRET=
WINKELNU_IMPORT_TRIGGER_SECRET=

# Production release promotion gate.
# These values identify the exact release being promoted; never use a branch name as the release SHA.
# Run before production/domain promotion with:
# npm run verify:release-promotion
WINKELNU_RELEASE_SHA=
WINKELNU_RELEASE_ENVIRONMENT=production
WINKELNU_RELEASE_ORIGIN=https://winkelnu.nl

# Domain cutover acceptance.
# Run immediately after DNS/domain promotion with:
# npm run verify:domain-cutover
WINKELNU_CUTOVER_ORIGIN=https://winkelnu.nl
# `redirect` requires https://www.winkelnu.nl to exist and redirect to the apex canonical host.
# `unused` means the www host is intentionally not part of the launch contract.
WINKELNU_CUTOVER_WWW_MODE=redirect

# Launch acceptance verifier. These are operator inputs, not application secrets.
# Run manually against the exact promoted HTTPS origin with:
# npm run verify:live-deployment
WINKELNU_ACCEPTANCE_ORIGIN=
# Optional first real product and offer journey, for example /product/example and /uit/<offer-id>?from=/product/example.
WINKELNU_ACCEPTANCE_PRODUCT_PATH=
WINKELNU_ACCEPTANCE_OFFER_PATH=
# Optional exact external merchant host expected from the offer redirect, for example www.example-shop.nl.
WINKELNU_ACCEPTANCE_MERCHANT_HOST=

# Affiliate/feed integrations are intentionally namespaced and added as partners are approved.
# Never commit production credentials or private generated feed URLs.

# Daisycon M0.18 readiness contract.
# The generated product-feed URL is treated as a server secret because it can identify account/media/feed configuration.
DAISYCON_PRODUCT_FEED_URL=
# OAuth/API values are prepared for publisher/program metadata and future API operations.
# They are not required by the product-feed transport adapter until an API use-case is enabled.
DAISYCON_CLIENT_ID=
DAISYCON_CLIENT_SECRET=
DAISYCON_PUBLISHER_ID=
DAISYCON_MEDIA_ID=

# bol Affiliate product feed.
# Explicit production activation gate.
# Keep false until the production worker outbound IPv4 is whitelisted at bol.
BOL_PRODUCT_FEED_IMPORT_ENABLED=false
# Server-only JSON credential bundle resolved through integration secretRef.
# Example secretRef in the integration registry:
# env:BOL_PRODUCT_FEED_CREDENTIALS
# Never commit the real username or password.
BOL_PRODUCT_FEED_CREDENTIALS=

# Server-local staging directory for downloaded bol .csv.gz feeds.
# The production worker must run on infrastructure whose outbound IPv4
# is whitelisted in the bol Affiliate product-feed settings.
BOL_PRODUCT_FEED_STAGING_DIR=/tmp/winkelnu-bol-feeds
