# Public application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Catalog persistence: memory | supabase
CATALOG_PERSISTENCE=memory

# Supabase server configuration.
# SUPABASE_SERVICE_ROLE_KEY is privileged and MUST NEVER be exposed with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Optional browser-side Supabase configuration. Leave empty until a public client use-case exists.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only operations trigger used by a trusted scheduler/worker.
# Generate a long random value. Never expose it to browser code or commit a real value.
WINKELNU_IMPORT_TRIGGER_SECRET=

# Affiliate/feed integrations are intentionally namespaced and added as partners are approved.
# Never commit production credentials or private generated feed URLs.

# Daisycon M0.18 readiness contract.
# The generated product-feed URL is treated as a server secret because it can identify account/media/feed configuration.
DAISYCON_PRODUCT_FEED_URL=
# OAuth/API values are prepared for publisher/program metadata and future API operations.
# They are not required by the product-feed transport adapter until an API use-case is enabled.
DAISYCON_CLIENT_ID=
DAISYCON_CLIENT_SECRET=
DAISYCON_PUBLISHER_ID=
DAISYCON_MEDIA_ID=
